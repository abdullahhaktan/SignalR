@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

@await Component.InvokeAsync("_DefaultSliderComponentPartial")

@await Component.InvokeAsync("_DefaultOfferComponentPartial")

@await Component.InvokeAsync("_DefaultOurMenuComponentPartial")

@await Component.InvokeAsync("_DefaultAboutComponentPartial")

@await Html.PartialAsync("SendMessage.cshtml")

@await Component.InvokeAsync("_DefaultTestimonialComponentPartial")

<!-- SADECE BURADA SCRIPT OLSUN -->
@if (ViewBag.ScrollToContact != null && ViewBag.ScrollToContact == true)
{
    <script>
        // Sayfa tam yüklendiğinde contact bölümüne kaydır
        window.addEventListener('load', function() {
            const contactSection = document.getElementById('contact');
            if(contactSection) {
                contactSection.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }
        });
    </script>
}